{
  "name": "connectly",
  "private": true,
  "version": "0.1.0",
  "description": "Connectly — real-time messaging web application (MVP)",
  "workspaces": ["client", "server"],
  "scripts": {
    "setup": "npm install --workspace=client && npm install --workspace=server",
    "dev": "concurrently \"npm run dev --workspace=server\" \"npm run dev --workspace=client\"",
    "build": "npm run build --workspace=server && npm run build --workspace=client",
    "lint": "npm run lint --workspace=server && npm run lint --workspace=client",
    "start": "npm run start --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=20"
  }
}
